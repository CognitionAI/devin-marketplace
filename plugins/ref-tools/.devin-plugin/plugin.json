{
  "name": "ref-tools",
  "displayName": "Ref.tools",
  "description": "Search documentation with Ref, filtering to the context you need with minimal token usage",
  "shortDescription": "Search docs with focused context",
  "homepage": "https://ref.tools",
  "repository": "https://github.com/ref-tools/ref-tools-mcp",
  "logo": "logo.svg",
  "keywords": [
    "Productivity",
    "Development Tools"
  ],
  "mcpServers": {
    "ref-tools": {
      "command": "npx",
      "args": [
        "ref-tools-mcp@latest"
      ],
      "env": {
        "REF_API_KEY": "${REF_API_KEY}"
      }
    }
  }
}
