{
  "name": "aws-elasticache",
  "displayName": "Amazon ElastiCache",
  "description": "Manage Redis and Memcached caches in Amazon ElastiCache",
  "shortDescription": "Redis and Memcached caching",
  "homepage": "https://aws.amazon.com/elasticache/",
  "repository": "https://github.com/awslabs/mcp",
  "logo": "logo.svg",
  "keywords": [
    "Databases"
  ],
  "mcpServers": {
    "aws-elasticache": {
      "command": "uvx",
      "args": [
        "awslabs.elasticache-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "${AWS_PROFILE}",
        "AWS_REGION": "${AWS_REGION}"
      }
    }
  }
}
