{
  "name": "grafana",
  "displayName": "Grafana (stdio)",
  "description": "Inspect Grafana dashboards and visualizations to investigate service metrics",
  "shortDescription": "Dashboards, data sources and alerts",
  "homepage": "https://grafana.com",
  "repository": "https://github.com/grafana/mcp-grafana",
  "logo": "logo.svg",
  "keywords": [
    "Monitoring & Analytics"
  ],
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_API_KEY",
        "grafana/mcp-grafana",
        "-t",
        "stdio"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
      }
    }
  }
}
