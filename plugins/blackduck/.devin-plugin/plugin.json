{
  "name": "blackduck",
  "displayName": "Black Duck",
  "description": "Scan code changes, files, and directories for security vulnerabilities with Black Duck Signal's AI-powered analysis.",
  "homepage": "https://www.blackduck.com/signal-ai-appsec.html",
  "repository": "https://github.com/blackducksoftware/mcp-server",
  "logo": "logo.png",
  "keywords": [
    "Development Tools",
    "Security"
  ],
  "mcpServers": {
    "blackduck": {
      "command": "npx",
      "args": [
        "-y",
        "@black-duck/mcp-server@1.1.8"
      ],
      "env": {
        "BLACKDUCK_MCP_GATEWAY_KEY": "${BLACKDUCK_MCP_GATEWAY_KEY}"
      }
    }
  }
}
