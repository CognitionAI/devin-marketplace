{
  "name": "aws-aurora-postgresql",
  "displayName": "Amazon Aurora PostgreSQL",
  "description": "Amazon Aurora PostgreSQL integration for managed PostgreSQL database operations",
  "homepage": "https://aws.amazon.com/rds/aurora/",
  "repository": "https://github.com/awslabs/mcp",
  "logo": "logo.svg",
  "keywords": [
    "Databases"
  ],
  "mcpServers": {
    "aws-aurora-postgresql": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "AWS_ACCESS_KEY_ID",
        "-e",
        "AWS_SECRET_ACCESS_KEY",
        "-e",
        "AWS_REGION",
        "awslabs/postgres-mcp-server:latest",
        "--resource_arn",
        "${MCP_AWS_RESOURCE_ARN}",
        "--secret_arn",
        "${MCP_AWS_SECRET_ARN}",
        "--database",
        "${MCP_AWS_DATABASE}",
        "--region",
        "${MCP_AWS_DATABASE_REGION}",
        "--readonly",
        "True"
      ],
      "env": {
        "AWS_ACCESS_KEY_ID": "${MCP_AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${MCP_AWS_SECRET_ACCESS_KEY}",
        "AWS_REGION": "${MCP_AWS_REGION}",
        "AWS_RESOURCE_ARN": "${MCP_AWS_RESOURCE_ARN}",
        "AWS_SECRET_ARN": "${MCP_AWS_SECRET_ARN}",
        "AWS_DATABASE": "${MCP_AWS_DATABASE}",
        "AWS_DATABASE_REGION": "${MCP_AWS_DATABASE_REGION}"
      }
    }
  }
}
