{
  "name": "aws-aurora-dsql",
  "displayName": "Amazon Aurora DSQL",
  "description": "Run SQL operations on Amazon Aurora DSQL distributed databases",
  "shortDescription": "Serverless distributed SQL queries",
  "homepage": "https://aws.amazon.com/rds/aurora/",
  "repository": "https://github.com/awslabs/mcp",
  "logo": "logo.svg",
  "keywords": [
    "Databases"
  ],
  "mcpServers": {
    "aws-aurora-dsql": {
      "command": "uvx",
      "args": [
        "awslabs.aurora-dsql-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "${AWS_PROFILE}",
        "AWS_REGION": "${AWS_REGION}"
      }
    }
  }
}
