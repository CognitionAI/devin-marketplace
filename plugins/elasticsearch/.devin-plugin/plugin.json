{
  "name": "elasticsearch",
  "displayName": "Elasticsearch",
  "description": "Inspect Elasticsearch indices, mappings, and shards, and run ES|QL or Query DSL searches",
  "shortDescription": "Search indexes, mappings and health",
  "homepage": "https://www.elastic.co",
  "logo": "logo.svg",
  "keywords": [
    "Monitoring & Analytics"
  ],
  "mcpServers": {
    "elasticsearch": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "ES_URL",
        "-e",
        "ES_API_KEY",
        "mcp/elasticsearch",
        "stdio"
      ],
      "env": {
        "ES_URL": "${ES_URL}",
        "ES_API_KEY": "${ES_API_KEY}"
      }
    }
  }
}
