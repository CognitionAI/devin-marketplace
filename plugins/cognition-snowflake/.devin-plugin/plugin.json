{
  "name": "cognition-snowflake",
  "displayName": "Snowflake",
  "description": "Query Snowflake warehouse data",
  "shortDescription": "Data warehouse queries and modeling",
  "setup": {
    "notice": "Choose password or key-pair authentication for your Snowflake account. Connect with a dedicated read-only role: the role's grants are what limit the queries this plugin can run.",
    "steps": [
      "Create a dedicated Snowflake role with USAGE on the warehouse, database and schemas Devin should query and SELECT on the tables it may read; do not use ACCOUNTADMIN or another administrative role",
      "Grant that role to the connecting user (a dedicated service user is recommended) and set it as the plugin's role",
      "Point the plugin at a warehouse sized for interactive queries and, where possible, at a single database and schema"
    ]
  },
  "homepage": "https://www.snowflake.com",
  "repository": "https://github.com/cognitionai/database-toolbox",
  "logo": "logo.svg",
  "keywords": [
    "Databases",
    "Monitoring & Analytics"
  ],
  "mcpServers": {
    "cognition-snowflake": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "SNOWFLAKE_ACCOUNT",
        "-e",
        "SNOWFLAKE_USER",
        "-e",
        "SNOWFLAKE_PASSWORD",
        "-e",
        "SNOWFLAKE_PRIVATE_KEY",
        "-e",
        "SNOWFLAKE_PRIVATE_KEY_FILE_PWD",
        "-e",
        "SNOWFLAKE_ROLE",
        "-e",
        "SNOWFLAKE_WAREHOUSE",
        "-e",
        "SNOWFLAKE_DATABASE",
        "-e",
        "SNOWFLAKE_SCHEMA",
        "ghcr.io/cognitionai/database-toolbox/snowflake-mcp:main"
      ],
      "env": {
        "SNOWFLAKE_ACCOUNT": "${SNOWFLAKE_ACCOUNT}",
        "SNOWFLAKE_USER": "${SNOWFLAKE_USER}",
        "SNOWFLAKE_PASSWORD": "${SNOWFLAKE_PASSWORD}",
        "SNOWFLAKE_PRIVATE_KEY": "${SNOWFLAKE_PRIVATE_KEY}",
        "SNOWFLAKE_PRIVATE_KEY_FILE_PWD": "${SNOWFLAKE_PRIVATE_KEY_FILE_PWD}",
        "SNOWFLAKE_ROLE": "${SNOWFLAKE_ROLE}",
        "SNOWFLAKE_WAREHOUSE": "${SNOWFLAKE_WAREHOUSE}",
        "SNOWFLAKE_DATABASE": "${SNOWFLAKE_DATABASE}",
        "SNOWFLAKE_SCHEMA": "${SNOWFLAKE_SCHEMA}"
      }
    }
  }
}
