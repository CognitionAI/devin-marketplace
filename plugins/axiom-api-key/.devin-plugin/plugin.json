{
  "name": "axiom-api-key",
  "displayName": "Axiom (API key)",
  "description": "Query Axiom logs, traces, and events with APL, inspect dataset schemas, and monitor alerts",
  "shortDescription": "Logs, traces and events",
  "homepage": "https://axiom.co",
  "logo": "logo.svg",
  "keywords": [
    "Monitoring & Analytics"
  ],
  "mcpServers": {
    "axiom-api-key": {
      "url": "https://mcp.axiom.co/mcp",
      "headers": {
        "Authorization": "${AXIOM_API_KEY_AUTHORIZATION}",
        "x-axiom-org-id": "${AXIOM_API_KEY_X_AXIOM_ORG_ID}"
      }
    }
  }
}
