{
  "name": "google-search-console",
  "displayName": "Google Search Console",
  "description": "Google Search Console MCP server for search performance analytics, keyword rankings, sitemaps, and indexing health",
  "shortDescription": "Search performance and SEO health",
  "homepage": "https://github.com/surendranb/google-search-console-mcp",
  "keywords": [
    "Productivity",
    "Developer Tools"
  ],
  "mcpServers": {
    "google-search-console": {
      "command": "uvx",
      "args": [
        "google-search-console-mcp==0.10.10"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    }
  }
}
