{
  "name": "dockerhub",
  "displayName": "Docker Hub",
  "description": "Find Docker Hub repositories, tags, and Hardened Images, and manage repository metadata",
  "shortDescription": "Container images, repositories and tags",
  "homepage": "https://hub.docker.com",
  "logo": "logo.svg",
  "keywords": [
    "Development Tools"
  ],
  "mcpServers": {
    "dockerhub": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "HUB_PAT_TOKEN",
        "mcp/dockerhub",
        "--transport=stdio",
        "--username=${DOCKERHUB_USERNAME}"
      ],
      "env": {
        "HUB_PAT_TOKEN": "${HUB_PAT_TOKEN}"
      }
    }
  }
}
