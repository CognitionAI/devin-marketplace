{
  "name": "aws-dynamodb",
  "displayName": "Amazon DynamoDB",
  "description": "Query and update DynamoDB tables and items",
  "shortDescription": "NoSQL tables and item operations",
  "homepage": "https://aws.amazon.com/dynamodb/",
  "repository": "https://github.com/awslabs/mcp",
  "logo": "logo.svg",
  "keywords": [
    "Databases"
  ],
  "mcpServers": {
    "aws-dynamodb": {
      "command": "uvx",
      "args": [
        "awslabs.dynamodb-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "${AWS_PROFILE}",
        "AWS_REGION": "${AWS_REGION}"
      }
    }
  }
}
