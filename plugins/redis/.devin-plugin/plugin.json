{
  "name": "redis",
  "displayName": "Redis",
  "description": "Read and write Redis keys, strings, hashes, lists, sets, streams, and JSON, use pub/sub, and inspect server stats",
  "shortDescription": "Redis keys, data structures and stats",
  "homepage": "https://redis.io",
  "logo": "logo.svg",
  "keywords": [
    "Databases"
  ],
  "mcpServers": {
    "redis": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "--name",
        "redis-mcp-server",
        "-i",
        "-e",
        "REDIS_HOST=${REDIS_HOST}",
        "-e",
        "REDIS_PORT=${REDIS_PORT}",
        "-e",
        "REDIS_USERNAME=${REDIS_USERNAME}",
        "-e",
        "REDIS_PWD=${REDIS_PWD}",
        "mcp/redis"
      ]
    }
  }
}
