{
  "name": "google-maps",
  "displayName": "Google Maps",
  "description": "Search places and details, geocode and reverse-geocode addresses, and get directions, distances, and elevation with Google Maps",
  "shortDescription": "Places, routes and geocoding",
  "homepage": "https://maps.google.com",
  "logo": "logo.svg",
  "keywords": [
    "Productivity"
  ],
  "mcpServers": {
    "google-maps": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-google-maps"
      ],
      "env": {
        "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
      }
    }
  }
}
