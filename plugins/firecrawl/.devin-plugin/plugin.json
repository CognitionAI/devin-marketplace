{
  "name": "firecrawl",
  "displayName": "Firecrawl",
  "description": "Map sites, scrape one or many URLs, search the web, run deep research, and extract structured data with Firecrawl",
  "shortDescription": "Website search, scraping and extraction",
  "homepage": "https://firecrawl.dev",
  "repository": "https://github.com/mendableai/firecrawl-mcp-server",
  "logo": "logo.png",
  "keywords": [
    "Development Tools"
  ],
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    }
  }
}
