{
  "name": "hasdata-instagram",
  "displayName": "Instagram MCP Server",
  "description": "Public Instagram profiles and public post feeds by handle, with hashtags and mentions parsed, as structured JSON. Runs on HasData's hosted API.",
  "homepage": "https://hasdata.com/apis/instagram-profile-api",
  "repository": "https://github.com/HasData/instagram-mcp",
  "logo": "logo.svg",
  "keywords": [
    "Customer & Sales",
    "Development Tools"
  ],
  "mcpServers": {
    "hasdata-instagram": {
      "url": "https://mcp.hasdata.com/mcp?apis=instagram",
      "headers": {
        "x-api-key": "${HASDATA_API_KEY}"
      }
    }
  }
}
