{
  "name": "playwright",
  "displayName": "Playwright",
  "description": "Automate browsers with Playwright: navigate pages, handle dialogs, upload files, intercept network requests, take snapshots, and run JavaScript",
  "shortDescription": "Browser actions, testing and automation",
  "homepage": "https://playwright.dev",
  "logo": "logo.svg",
  "keywords": [
    "Development Tools"
  ],
  "mcpServers": {
    "playwright": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--security-opt",
        "seccomp=${CLAUDE_PLUGIN_ROOT}/seccomp.json",
        "--entrypoint",
        "/usr/bin/tini",
        "mcr.microsoft.com/playwright/mcp@sha256:690763cbb437ee7233f538a953bb5390bf03791eb5c965b471e59d17a6132fcb",
        "-s",
        "--",
        "node",
        "/app/cli.js",
        "--headless",
        "--browser",
        "chromium",
        "--sandbox"
      ]
    }
  }
}
