{
  "name": "unleash",
  "displayName": "Unleash",
  "description": "Create Unleash flags with best-practice validation, configure rollouts, toggle environments, and wrap code in flag checks",
  "shortDescription": "Feature flags and rollout controls",
  "homepage": "https://www.getunleash.io",
  "repository": "https://github.com/Unleash/unleash-mcp",
  "logo": "logo.png",
  "keywords": [
    "Development Tools"
  ],
  "mcpServers": {
    "unleash": {
      "command": "npx",
      "args": [
        "-y",
        "@unleash/mcp@latest",
        "--log-level",
        "error"
      ],
      "env": {
        "UNLEASH_BASE_URL": "${UNLEASH_BASE_URL}",
        "UNLEASH_PAT": "${UNLEASH_PAT}",
        "UNLEASH_DEFAULT_PROJECT": "${UNLEASH_DEFAULT_PROJECT}"
      }
    }
  }
}
