{
  "name": "slack",
  "displayName": "Slack (STDIO)",
  "description": "Find Slack channels and users, read history, and post messages, thread replies, and reactions",
  "shortDescription": "Team chat, channels and threads",
  "homepage": "https://slack.com",
  "logo": "logo.svg",
  "keywords": [
    "Communication"
  ],
  "mcpServers": {
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}",
        "SLACK_CHANNEL_IDS": "${SLACK_CHANNEL_IDS}"
      }
    }
  }
}
