{
  "name": "cognition-firestore",
  "displayName": "Firestore",
  "description": "Query and manage Firestore documents and collections",
  "shortDescription": "Firestore documents and data queries",
  "homepage": "https://github.com/googleapis/genai-toolbox",
  "logo": "logo.svg",
  "keywords": [
    "Databases"
  ],
  "mcpServers": {
    "cognition-firestore": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "FIRESTORE_PROJECT",
        "-e",
        "FIRESTORE_DATABASE",
        "-e",
        "GOOGLE_SERVICE_ACCOUNT_JSON",
        "ghcr.io/cognitionai/database-toolbox/firestore:main",
        "--stdio"
      ],
      "env": {
        "FIRESTORE_PROJECT": "${FIRESTORE_PROJECT}",
        "FIRESTORE_DATABASE": "${FIRESTORE_DATABASE}",
        "GOOGLE_SERVICE_ACCOUNT_JSON": "${GOOGLE_SERVICE_ACCOUNT_JSON}"
      }
    }
  }
}
