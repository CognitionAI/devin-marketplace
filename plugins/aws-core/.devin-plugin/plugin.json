{
  "name": "aws-core",
  "displayName": "AWS Core",
  "description": "AWS MCP Server via the Agent Toolkit for AWS: run AWS CLI commands, search AWS documentation, and follow curated AWS skills, authenticated with your local AWS credentials (SigV4)",
  "homepage": "https://aws.amazon.com/products/developer-tools/agent-toolkit-for-aws/",
  "repository": "https://github.com/aws/mcp-proxy-for-aws",
  "logo": "logo.svg",
  "keywords": [
    "Development Tools"
  ],
  "mcpServers": {
    "aws-core": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws-cli@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp"
      ],
      "env": {
        "AWS_PROFILE": "${AWS_PROFILE}",
        "AWS_REGION": "${AWS_REGION}"
      }
    }
  }
}
