{
  "name": "aws-lambda",
  "displayName": "AWS Lambda",
  "description": "Manage and deploy AWS Lambda functions",
  "shortDescription": "Serverless function deployment",
  "homepage": "https://aws.amazon.com/lambda/",
  "repository": "https://github.com/awslabs/mcp",
  "logo": "logo.svg",
  "keywords": [
    "Cloud & Infrastructure"
  ],
  "mcpServers": {
    "aws-lambda": {
      "command": "uvx",
      "args": [
        "awslabs.lambda-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "${AWS_PROFILE}",
        "AWS_REGION": "${AWS_REGION}"
      }
    }
  }
}
