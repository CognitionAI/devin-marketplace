{
  "name": "pulumi",
  "displayName": "Pulumi",
  "description": "Preview and update Pulumi stacks and manage cloud configurations",
  "shortDescription": "Cloud stacks and infrastructure updates",
  "homepage": "https://www.pulumi.com",
  "logo": "logo.svg",
  "keywords": [
    "Cloud & Infrastructure"
  ],
  "mcpServers": {
    "pulumi": {
      "command": "npx",
      "args": [
        "-y",
        "@pulumi/mcp-server",
        "stdio"
      ],
      "env": {
        "PULUMI_ACCESS_TOKEN": "${PULUMI_ACCESS_TOKEN}",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "AWS_SESSION_TOKEN": "${AWS_SESSION_TOKEN}"
      }
    }
  }
}
