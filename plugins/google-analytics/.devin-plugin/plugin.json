{
  "name": "google-analytics",
  "displayName": "Google Analytics 4",
  "description": "Google Analytics 4 MCP server for real-time reporting, schema discovery, metric aggregation, and audience insights",
  "shortDescription": "GA4 reporting and audience insights",
  "homepage": "https://ga4mcp.com/",
  "keywords": [
    "Monitoring & Analytics",
    "Productivity"
  ],
  "mcpServers": {
    "google-analytics": {
      "command": "uvx",
      "args": [
        "google-analytics-mcp==2.11.6"
      ],
      "env": {
        "GA4_PROPERTY_ID": "${GA4_PROPERTY_ID}",
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    }
  }
}
