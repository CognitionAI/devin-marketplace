  "homepage": "https://hasdata.com/apis/zillow-api",
  "repository": "https://github.com/HasData/zillow-mcp",
  "logo": "logo.svg",
  "keywords": [
    "Development Tools",
    "Productivity"
  ],
  "mcpServers": {
    "hasdata-zillow": {
      "url": "https://mcp.hasdata.com/mcp?apis=zillow",
      "headers": {
        "x-api-key": "${HASDATA_API_KEY}"
      }
    }
  }
}
